{
  "name": "clean-architecture-vue-3",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "author": {
    "email": "oscar.eduardo.raygoza@gmail.com",
    "name": "Oscar Eduardo Raygoza"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "npm run build-only && wrangler dev",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "format": "prettier --write src/",
    "deploy": "npm run build-only && wrangler deploy"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.21",
    "@vueuse/core": "^12.8.2",
    "@vueuse/head": "^2.0.0",
    "@zxing/browser": "^0.1.5",
    "flyonui": "^1.3.1",
    "inversify": "^6.2.2",
    "inversify-inject-decorators": "^3.1.0",
    "leaflet": "^1.9.4",
    "pinia": "^2.3.1",
    "qrcode": "^1.5.4",
    "vue": "^3.5.32",
    "vue-i18n": "^11.3.2",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.36.3",
    "@playwright/test": "^1.59.1",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^22.19.17",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.39.4",
    "eslint-plugin-oxlint": "^0.11.1",
    "eslint-plugin-playwright": "^2.10.1",
    "eslint-plugin-vue": "^9.33.0",
    "npm-run-all2": "^8.0.4",
    "oxlint": "^0.11.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.4.2",
    "vite-plugin-vue-devtools": "^7.7.9",
    "vue-tsc": "^2.2.12",
    "wrangler": "^4.90.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.38.0"
  }
}
