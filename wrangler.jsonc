{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tribo-app",
  "compatibility_date": "2026-05-08",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "build": {
    "command": "npm run build-only"
  }
}
